[Unit]
Description=Mohsen automatic TLS issue and renew
After=network-online.target nginx.service mohsen.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/mohsen
EnvironmentFile=-/etc/mohsen/mohsen.env
ExecStart=/opt/mohsen/.venv/bin/python manage.py tls_maintain
TimeoutStartSec=700

[Install]
WantedBy=multi-user.target
